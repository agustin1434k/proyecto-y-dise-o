<?php
// SOLO COMO REFERENCIA. Si ya tenés un conexion.php que funciona, NO lo reemplaces.
// reportes.php necesita que conexion.php deje un objeto PDO en la variable $pdo.
$host = 'localhost';
$base = 'gestion_clientes';
$usuario = 'root';
$clave = '';

try {
    $pdo = new PDO("mysql:host=$host;dbname=$base;charset=utf8mb4", $usuario, $clave, [
        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    ]);
} catch (PDOException $e) {
    die('No se pudo conectar con la base de datos.');
}
